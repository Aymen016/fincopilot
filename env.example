# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DATABASE_URL=sqlite+aiosqlite:///./fincopilot.db

# Optional — for AI chat via Anthropic (Ollama is used by default, no key needed)
ANTHROPIC_API_KEY=

# Optional — for CSV bulk upload to S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=fincopilot-uploads

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
